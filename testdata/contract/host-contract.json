        "os": "linux",
        "arch": "amd64",
        "header": "manar-edge/0.4.2 (linux; amd64)"
      },
      {
        "version": "dev",
        "os": "windows",
        "arch": "arm64",
        "header": "manar-edge/dev (windows; arm64)"
      }
